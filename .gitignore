# macOS sistem dosyaları
.DS_Store
._*

# Yerel ortam değişkenleri (örnek dosyalar paylaşılabilir)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Bağımlılıklar ve Python önbellekleri
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Editör ve geçici dosyalar
.idea/
.vscode/
*.swp
*.swo
*~
*.log

# Yerel otomatik kontrol raporları
reports/

# Yerel tasarım ve karşılaştırma önizlemeleri
/*-onizleme.html

/assets/previews/
/tools/*-onizleme.py

# Yerel çalışma alanları ve tarayıcı test çıktıları
/tmp/
/temp/
/screenshots/
/playwright-report/
/test-results/
/coverage/

# Yerel kimlik bilgileri ve özel anahtarlar
/private/
*.key
*.p12
*.pfx
